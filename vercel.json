{
  "version": 2,
  "rewrites": [
    {"source": "/api/:path*", "destination": "https://capture-a-fly.onrender.com/api/:path*"},
    {"source": "/ws", "destination": "https://capture-a-fly.onrender.com/ws"},
    {"source": "/game/:path*", "destination": "https://capture-a-fly.onrender.com/game/:path*"}
  ],
  "headers": [
    {"source": "/game/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}]}
  ]
}
